# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Kubernetes namespace where EPP and model server are deployed
NAMESPACE=my-namespace

# Helm release name (used to derive EPP deployment/service names)
GUIDE_NAME=agentic-serving

# Model server deployment name
MODEL_DEPLOY=agentic-workloads-nvidia-gpu-vllm-decode

# inference-perf container image
INFERENCE_PERF_IMAGE=quay.io/pavanipenumalla1/inference-perf:latest

# EPP image coordinates
EPP_IMAGE_REGISTRY=quay.io/pavanipenumalla1
EPP_IMAGE_REPO=llm-d-router-endpoint-picker
EPP_IMAGE_TAG=program-aware-las-v2
